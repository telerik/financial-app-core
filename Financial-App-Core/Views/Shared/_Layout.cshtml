<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="@Url.Content("~/favicon.ico")" />

    <title>@ViewData["Title"] - Financial Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-material@13.0.1/dist/material-main-dark.css" integrity="sha256-KZ2Vs8Qy4luxSO2swHD2haKvCjsOfBYNhh8eGzbg+vU=" crossorigin="anonymous" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://unpkg.com/@@progress/kendo-font-icons/dist/index.css" />
    <script>
        localStorage.removeItem("selectedCurrency");
    </script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://unpkg.com/jszip/dist/jszip.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@progress/kendo-ui@2026.1.212/umd/kendo.all.min.js" integrity="sha256-v+IMyE62Iixh4rTW0smdBxKRy/K8Nw9gYU0+NnanEJY=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@progress/kendo-ui@2026.1.212/umd/kendo.aspnetmvc.min.js" integrity="sha256-q2PyM094fKjYkuo4z6fmotmhMwpZDvQIdCQ4kyh94uw=" crossorigin="anonymous"></script>
    <script src="@Url.Content("~/js/site.js")"></script>

    <link rel="stylesheet" href="@Url.Content("~/lib/bootstrap/css/bootstrap.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@progress/kendo-theme-utils@13.0.1/dist/all.css" integrity="sha256-pREck8i2x7Y3EYBcncrMztNci+/lQeB7Wy/rGQpY24E=" crossorigin="anonymous" />
</head>
<body class="k-content">
    
    @RenderBody()

    <div class="k-py-6.5 k-px-15 k-bg-surface-alt">
        <a class="k-link k-avatar k-primary" href="https://github.com/telerik/financial-app-core" style="display: inline-flex; align-items: center; gap: 0.5rem; color: white;">
            <img src="@Url.Content("~/images/GitHub-logo.svg")" alt="UNI" style="width: 25px; height: 25px;" />
            <span class="footerText">Get the Source Code</span>
        </a>

        <p class="!k-my-0 footerText">Copyright © 2025 Progress Software. All rights reserved.</p>
    </div>
     
</body>
</html>